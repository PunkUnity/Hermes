+static av_cold int vaapi_encode_init_intra_refresh(AVCodecContext *avctx)
+{
+    VAAPIEncodeContext         *ctx = avctx->priv_data;
+#if VA_CHECK_VERSION(1, 0, 0)
+    FFHWBaseEncodeContext *base_ctx = avctx->priv_data;
+    VAConfigAttrib attr = { VAConfigAttribEncIntraRefresh };
+    VAStatus vas;
+    int block;
+
+    vas = vaGetConfigAttributes(ctx->hwctx->display,
+                                ctx->va_profile,
+                                ctx->va_entrypoint,
+                                &attr, 1);
+    if (vas != VA_STATUS_SUCCESS || attr.value == VA_ATTRIB_NOT_SUPPORTED ||
+        !(attr.value & VA_ENC_INTRA_REFRESH_ROLLING_ROW)) {
+        av_log(avctx, AV_LOG_WARNING, "The driver does not support rolling "
+               "intra refresh in rows; intra refresh is off.\n");
+        ctx->intra_refresh = 0;
+        return 0;
+    }
+    // Drivers turn it off with B-frames, and the band would refresh out of order.
+    if (base_ctx->b_per_p > 0) {
+        av_log(avctx, AV_LOG_WARNING, "Intra refresh needs a stream without "
+               "B-frames; intra refresh is off.\n");
+        ctx->intra_refresh = 0;
+        return 0;
+    }
+
+    // Rows of macroblocks for H.264, of 64x64 coding tree or super blocks
+    // for HEVC and AV1, in the units the driver counts the band in.
+    block = avctx->codec_id == AV_CODEC_ID_H264 ? 16 : 64;
+    ctx->ir_rows = (avctx->height + block - 1) / block;
+    ctx->ir_rows_per_frame = FFMAX(1, (ctx->ir_rows + ctx->intra_refresh - 1) /
+                                      ctx->intra_refresh);
+    ctx->ir_next_row = 0;
+    av_log(avctx, AV_LOG_VERBOSE, "Rolling intra refresh: %d of %d block rows "
+           "per frame.\n", ctx->ir_rows_per_frame, ctx->ir_rows);
+#else
+    ctx->intra_refresh = 0;
+#endif
+    return 0;
+}
